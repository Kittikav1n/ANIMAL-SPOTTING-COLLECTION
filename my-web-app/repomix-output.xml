<file path="components/map/MobileSpotDrawer.tsx">
"use client";

import { useState, useRef, useEffect } from "react";
import { X, MapPin } from "lucide-react";
import { SpotPinData } from "@/components/MapComponent";
import AnimalIcon from "@/components/spotModal/AnimalIcon";

interface MobileSpotDrawerProps {
  spot: (SpotPinData & {
    timeAgo?: string;
    author?: SpotPinData["author"] & { role?: string };
  }) | null;
  category?: string | null;
  animalPinMap?: Record<string, string>;
  isOpen: boolean;
  onClose: () => void;
  onPhotoClick?: (imgUrl: string, index?: number) => void;
}

export default function MobileSpotDrawer({
  spot,
  category,
  animalPinMap,
  isOpen,
  onClose,
  onPhotoClick,
}: MobileSpotDrawerProps) {
  const [expandState, setExpandState] = useState<"collapsed" | "peek" | "full">(
    "collapsed"
  );

  useEffect(() => {
    if (isOpen) {
      setExpandState("collapsed");
    }
  }, [spot?.id, isOpen]);

  const touchStartY = useRef<number | null>(null);
  const touchCurrentY = useRef<number | null>(null);

  const handleTouchStart = (e: React.TouchEvent) => {
    touchStartY.current = e.touches[0].clientY;
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    touchCurrentY.current = e.touches[0].clientY;
  };

  const handleTouchEnd = () => {
    if (touchStartY.current === null || touchCurrentY.current === null) return;
    const diff = touchStartY.current - touchCurrentY.current;
    const threshold = 35;

    if (diff > threshold) {
      setExpandState((prev) => {
        if (prev === "collapsed") return "peek";
        if (prev === "peek") return "full";
        return "full";
      });
    } else if (diff < -threshold) {
      setExpandState((prev) => {
        if (prev === "full") return "peek";
        if (prev === "peek") return "collapsed";
        onClose();
        return "collapsed";
      });
    }

    touchStartY.current = null;
    touchCurrentY.current = null;
  };

  const toggleExpand = () => {
    setExpandState((prev) => {
      if (prev === "collapsed") return "peek";
      if (prev === "peek") return "full";
      return "collapsed";
    });
  };

  if (!isOpen) return null;

  const title = spot ? spot.title : `${category || "Animal"} nearby`;
  const images = spot?.images || [];
  const categories = spot?.category
    ? Array.isArray(spot.category)
      ? spot.category
      : [spot.category]
    : category
    ? [category]
    : [];

  return (
    <div
      className={`fixed left-0 right-0 z-40 bg-card rounded-t-3xl border-t border-border shadow-2xl transition-all duration-300 ease-out md:hidden flex flex-col bottom-[72px] overflow-hidden ${
        expandState === "collapsed"
          ? "h-[68px] px-5 pt-2 pb-3"
          : expandState === "peek"
          ? "h-[380px] px-5 pt-2 pb-4"
          : "h-[calc(100dvh-72px-32px)] px-5 pt-2 pb-4"
      }`}
      onTouchStart={handleTouchStart}
      onTouchMove={handleTouchMove}
      onTouchEnd={handleTouchEnd}
    >
      {/* 1. Drag handle pill at top */}
      <div
        onClick={toggleExpand}
        className="w-full flex justify-center py-1 cursor-pointer select-none shrink-0"
      >
        <div className="w-12 h-1 bg-muted-foreground/30 hover:bg-muted-foreground/50 rounded-full transition-colors" />
      </div>

      {/* 2. Header Row: Title + Close Button */}
      <div className="flex items-center justify-between gap-2 shrink-0 pt-0.5 pb-2">
        <div
          className="flex items-center gap-2 cursor-pointer flex-1 min-w-0"
          onClick={toggleExpand}
        >
          <h3 className="font-bold text-base text-foreground truncate">
            {title}
          </h3>
        </div>

        <button
          type="button"
          onClick={onClose}
          className="text-muted-foreground hover:text-foreground p-1 rounded-full hover:bg-muted transition-colors cursor-pointer shrink-0"
          aria-label="Close"
        >
          <X className="size-5" />
        </button>
      </div>

      {/* 3. Detailed content for "peek" and "full" states */}
      {expandState !== "collapsed" && (
        <div
          className={`flex-1 flex flex-col gap-3 min-h-0 ${
            expandState === "full"
              ? "overflow-y-auto custom-scrollbar pr-1 pb-4"
              : "overflow-hidden"
          }`}
        >
          {/* Full-width Top Border Row: Author (Left) + Animal Badges (Right) */}
          {(spot || categories.length > 0) && (
            <div className="w-full pt-2.5 border-t border-border/60 flex items-center justify-between gap-2 shrink-0">
              {/* Left: Author */}
              {spot ? (
                <div className="flex items-center gap-2 min-w-0">
                  <div className="size-7 rounded-full bg-amber-100/80 text-amber-800 flex items-center justify-center text-xs font-semibold border border-amber-200/80 shrink-0 uppercase">
                    {spot.author?.avatar || spot.author?.name?.charAt(0) || "A"}
                  </div>
                  <div className="flex flex-col min-w-0">
                    <div className="flex items-center gap-1.5 text-xs leading-tight">
                      <span className="font-semibold text-foreground truncate">
                        {spot.author?.name || "Spotter"}
                      </span>
                      {spot.timeAgo && (
                        <>
                          <span className="text-muted-foreground/60">•</span>
                          <span className="text-[11px] text-muted-foreground shrink-0">
                            {spot.timeAgo}
                          </span>
                        </>
                      )}
                    </div>
                    {spot.author?.role && (
                      <span className="text-[11px] text-muted-foreground truncate leading-tight">
                        {spot.author.role}
                      </span>
                    )}
                  </div>
                </div>
              ) : (
                <div />
              )}
            </div>
          )}
        {/* Animal Badge Tags */}
          {categories.length > 0 && (
            <div className="flex flex-wrap items-center gap-1.5 shrink-0">
              {categories.map((animalName) => {
                const key = animalName.toLowerCase();
                const pin =
                  animalPinMap?.[key] ||
                  spot?.pinName ||
                  "ph:paw-print-fill";
                return (
                  <span
                    key={animalName}
                    className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-accent text-accent-foreground text-[11px] font-semibold uppercase tracking-wide"
                  >
                    <AnimalIcon pinName={pin} className="size-3.5" />
                    {animalName}
                  </span>
                );
              })}
            </div>
          )}

          {/* Location */}
          {spot?.address && (
            <div
              className="flex items-center gap-1.5 text-xs text-muted-foreground min-w-0 shrink-0"
              title={spot.address}
            >
              <MapPin className="size-3.5 shrink-0 text-primary" />
              <span className="truncate">{spot.address}</span>
            </div>
          )}

          {/* Description */}
          {spot?.description && (
            <p className="text-sm font-medium text-muted-foreground leading-relaxed shrink-0 line-clamp-3">
              {spot.description}
            </p>
          )}

          {/* Photo Cards (2-Column Grid) */}
          {images.length > 0 && (
            <div className="grid grid-cols-2 gap-3 pt-0.5">
              {images.map((imgUrl, idx) => (
                <div
                  key={idx}
                  onClick={() => onPhotoClick?.(imgUrl, idx)}
                  className="aspect-[3/4] rounded-2xl overflow-hidden bg-muted cursor-pointer shadow-sm relative group shrink-0"
                >
                  <img
                    src={imgUrl}
                    alt={`spot-img-${idx}`}
                    className="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105"
                  />
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="components/map/SearchBar.tsx">
"use client";

import { useState, useRef, useEffect } from "react";
import { Filter, Search, Clock, X, MapPin, Loader2 } from "lucide-react";
import AnimalFilterChips, { AnimalChipItem } from "./AnimalFilterChips";

export interface LocationSearchResult {
  name: string;
  lat: number;
  lng: number;
}

interface SearchBarProps {
  value?: string;
  onChange?: (value: string) => void;
  onSelectLocation?: (location: LocationSearchResult) => void;
  placeholder?: string;
  animalItems?: AnimalChipItem[];
  activeAnimal?: string;
  onSelectAnimal?: (animal: string) => void;
  onFilterClick?: () => void;
  recentSearches?: LocationSearchResult[];
}

const STORAGE_KEY = "animal_spotting_recent_locations_v2";

export default function SearchBar({
  value = "",
  onChange,
  onSelectLocation,
  placeholder = "Search area",
  animalItems,
  activeAnimal = "ALL",
  onSelectAnimal,
  onFilterClick,
  recentSearches: propRecentSearches,
}: SearchBarProps) {
  const [isOpen, setIsOpen] = useState(false);
  const [recentSearches, setRecentSearches] = useState<LocationSearchResult[]>(
    propRecentSearches || []
  );
  const [suggestions, setSuggestions] = useState<LocationSearchResult[]>([]);
  const [isSearching, setIsSearching] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);

  // โหลดประวัติสถานที่ที่เคยค้นหาจาก LocalStorage
  useEffect(() => {
    if (propRecentSearches) {
      setRecentSearches(propRecentSearches);
      return;
    }
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed)) setRecentSearches(parsed);
      }
    } catch {
      // ignore
    }
  }, [propRecentSearches]);

  // ปิด Dropdown เมื่อคลิกนอกพื้นที่
  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      if (
        containerRef.current &&
        !containerRef.current.contains(e.target as Node)
      ) {
        setIsOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  // ค้นหาสถานที่ผ่าน OpenStreetMap Nominatim API (Debounce 400ms)
  useEffect(() => {
    const query = value.trim();
    if (!query) {
      setSuggestions([]);
      setIsSearching(false);
      return;
    }

    const controller = new AbortController();
    const timer = setTimeout(async () => {
      setIsSearching(true);
      try {
        // เน้นค้นหาในประเทศไทย (countrycodes=th) และจำกัด 5 รายการ
        // const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
        //   query
        // )}&countrycodes=th&limit=5&accept-language=th,en`;

        // ค้นรอบๆในมอ
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
          query
        )}&countrycodes=th&viewbox=100.487,13.657,100.498,13.646&bounded=1&limit=5&accept-language=th,en`;

        const res = await fetch(url, { signal: controller.signal });
        const data = await res.json();

        if (Array.isArray(data)) {
          const mapped: LocationSearchResult[] = data.map((item: any) => ({
            name: item.display_name,
            lat: parseFloat(item.lat),
            lng: parseFloat(item.lon),
          }));
          setSuggestions(mapped);
        }
      } catch (err: any) {
        if (err.name !== "AbortError") {
          console.error("Nominatim search error:", err);
        }
      } finally {
        setIsSearching(false);
      }
    }, 400);

    return () => {
      clearTimeout(timer);
      controller.abort();
    };
  }, [value]);

  const saveRecentSearches = (items: LocationSearchResult[]) => {
    setRecentSearches(items);
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch {
      // ignore
    }
  };

  const handleRemoveRecent = (e: React.MouseEvent, name: string) => {
    e.stopPropagation();
    const updated = recentSearches.filter((s) => s.name !== name);
    saveRecentSearches(updated);
  };

  const handleSelectLocation = (loc: LocationSearchResult) => {
    // ตัดชื่อให้สั้นลงสำหรับแสดงในช่อง Input (เอาเฉพาะ 2 ส่วนแรก)
    const shortName = loc.name.split(",").slice(0, 2).join(",").trim();
    const cleanLoc = { ...loc, name: shortName };

    onChange?.(shortName);
    onSelectLocation?.(cleanLoc);
    setIsOpen(false);

    // บันทึกลง Recent Searches
    const updated = [
      cleanLoc,
      ...recentSearches.filter((s) => s.name !== shortName),
    ].slice(0, 6);
    saveRecentSearches(updated);
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter" && value.trim()) {
      // ถ้ามีผลลัพธ์จาก Nominatim ให้เลือกตัวแรกทันที
      if (suggestions.length > 0) {
        handleSelectLocation(suggestions[0]);
      }
    }
  };

  return (
    <div ref={containerRef} className="relative w-full md:w-80 z-30">
      {/* Search Input Box */}
      <div
        className={`flex items-center bg-card border border-border px-4 py-2.5 gap-3 shadow-md ${
          isOpen
            ? "rounded-t-2xl rounded-b-none border-b-border/40"
            : "rounded-full"
        }`}
      >
        {/* Mobile Filter Button */}
        <div className="flex items-center gap-2.5 shrink-0 md:hidden">
          <button
            type="button"
            onClick={(e) => {
              e.stopPropagation();
              onFilterClick?.();
            }}
            className="text-[#c85a42] hover:opacity-80 cursor-pointer flex items-center justify-center"
            aria-label="Filter"
          >
            <Filter className="size-4 stroke-[2.2]" />
          </button>
          <div className="h-4 w-[1px] bg-border" />
        </div>

        {/* Input */}
        <input
          type="text"
          value={value}
          onFocus={() => setIsOpen(true)}
          onKeyDown={handleKeyDown}
          onChange={(e) => {
            onChange?.(e.target.value);
            if (!isOpen) setIsOpen(true);
          }}
          placeholder={placeholder}
          className="flex-1 bg-transparent text-sm font-light text-foreground placeholder:font-light placeholder:text-muted-foreground/60 outline-none min-w-0"
        />

        {/* Clear button หรือ Search / Loading Icon */}
        {value ? (
          <button
            type="button"
            onClick={() => {
              onChange?.("");
              setSuggestions([]);
            }}
            className="text-muted-foreground hover:text-foreground cursor-pointer shrink-0"
          >
            <X className="size-4" />
          </button>
        ) : isSearching ? (
          <Loader2 className="size-4 text-primary animate-spin shrink-0" />
        ) : (
          <Search className="size-4 text-primary shrink-0 hidden md:block" />
        )}
      </div>

      {/* Dropdown Menu */}
      {isOpen && (
        <div className="absolute top-full left-0 right-0 bg-card border border-t-0 border-border rounded-b-2xl shadow-xl z-50 overflow-hidden p-3 flex flex-col gap-3">
          {/* Mobile Quick Filter Chips */}
          <div className="w-full overflow-x-auto no-scrollbar md:hidden">
            <AnimalFilterChips
              items={animalItems}
              activeItem={activeAnimal}
              onSelect={(animal) => onSelectAnimal?.(animal)}
            />
          </div>

          {/* 1. ผลการค้นหาสถานที่จาก OpenStreetMap */}
          {value.trim().length > 0 && (
            <div className="flex flex-col gap-1">
              <span className="text-xs font-medium text-muted-foreground px-2 pt-1">
                {isSearching ? "Searching places..." : "Locations"}
              </span>

              {!isSearching && suggestions.length === 0 ? (
                <div className="px-2 py-3 text-xs text-muted-foreground text-center">
                  No places found
                </div>
              ) : (
                <div className="flex flex-col divide-y divide-border/40">
                  {suggestions.map((loc, idx) => (
                    <div
                      key={idx}
                      onClick={() => handleSelectLocation(loc)}
                      className="flex items-start gap-2.5 px-2 py-2.5 hover:bg-muted/50 rounded-xl cursor-pointer group"
                    >
                      <MapPin className="size-4 text-primary shrink-0 mt-0.5" />
                      <span className="text-xs sm:text-sm text-foreground/90 line-clamp-2 font-light group-hover:text-foreground">
                        {loc.name}
                      </span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* 2. ประวัติการค้นหาล่าสุด (แสดงเมื่อยังไม่ได้พิมพ์ค้นหา) */}
          {!value.trim() && recentSearches.length > 0 && (
            <div className="flex flex-col gap-1">
              <span className="text-xs font-medium text-muted-foreground px-2 pt-1">
                Recent
              </span>

              <div className="flex flex-col divide-y divide-border/40">
                {recentSearches.map((item, idx) => (
                  <div
                    key={idx}
                    onClick={() => handleSelectLocation(item)}
                    className="flex items-center justify-between px-2 py-2.5 hover:bg-muted/50 rounded-xl cursor-pointer group"
                  >
                    <div className="flex items-center gap-3 min-w-0">
                      <Clock className="size-3.5 text-muted-foreground shrink-0 group-hover:text-foreground" />
                      <span className="text-xs sm:text-sm text-foreground/90 truncate font-light group-hover:text-foreground">
                        {item.name}
                      </span>
                    </div>
                    <button
                      type="button"
                      onClick={(e) => handleRemoveRecent(e, item.name)}
                      className="p-1 text-muted-foreground hover:text-foreground rounded-full hover:bg-muted cursor-pointer"
                      aria-label="Remove search"
                    >
                      <X className="size-3.5" />
                    </button>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="components/map/SpotCard.tsx">
"use client";

import { useState } from "react";
import { X, ChevronDown, MapPin } from "lucide-react";
import AnimalIcon from "@/components/spotModal/AnimalIcon";

export interface SpotCardData {
  id?: string;
  title: string;
  address?: string;
  description: string;
  category: string[];
  pinName?: string;
  images: string[];
  author: {
    name: string;
    avatar?: string;
  };
}

interface SpotCardProps {
  data: SpotCardData;
  animalPinMap?: Record<string, string>;
  onClose?: () => void;
  onPhotoClick?: (imgUrl: string, index: number) => void;
  activePhotoIndex?: number;
}

export default function SpotCard({
  data,
  animalPinMap,
  onClose,
  onPhotoClick,
  activePhotoIndex,
}: SpotCardProps) {
  const [showAllPhotos, setShowAllPhotos] = useState(false);

  if (!data) return null;

  const images = data.images || [];
  const hasMoreThanTwo = images.length > 2;
  const displayedImages = showAllPhotos ? images : images.slice(0, 2);
  const categories = Array.isArray(data.category)
    ? data.category
    : data.category
    ? [data.category]
    : [];

  return (
    <div className="w-[360px] max-w-full max-h-[calc(100vh-112px)] bg-card rounded-3xl shadow-xl border border-border p-5 flex flex-col gap-3 text-foreground overflow-hidden">
      {/* Header Row: Title + Close Button */}
      <div className="flex items-start justify-between gap-2 shrink-0">
        <h2 className="text-lg font-bold tracking-tight text-foreground leading-snug line-clamp-2">
          {data.title}
        </h2>
        {onClose && (
          <button
            type="button"
            onClick={onClose}
            className="text-muted-foreground hover:text-foreground transition-colors p-1 -mr-1 -mt-0.5 rounded-full hover:bg-muted shrink-0 cursor-pointer"
            aria-label="Close card"
          >
            <X className="size-4" />
          </button>
        )}
      </div>

      {/* Full-width Top Border Row: Author (Left) + Animal Badges (Right) */}
      <div className="w-full pt-2.5 border-t border-border/60 flex items-center justify-between gap-2 shrink-0">
        {/* Left: Author */}
        <div className="flex items-center gap-2 min-w-0">
          <div className="size-7 rounded-full bg-amber-100/80 text-amber-800 flex items-center justify-center text-xs font-semibold border border-amber-200/80 shrink-0 uppercase">
            {data.author?.avatar || data.author?.name?.charAt(0) || "A"}
          </div>
          <span className="text-xs font-semibold text-foreground truncate">
            {data.author?.name || "Spotter"}
          </span>
        </div>

        {/* Right: Animal Badge Tags */}
        {categories.length > 0 && (
          <div className="flex flex-wrap items-center justify-end gap-1.5 shrink-0">
            {categories.map((animalName) => {
                const key = animalName.trim().toLowerCase();
                const pin = animalPinMap?.[key] || "ph:paw-print-fill";
                animalPinMap?.[key] || data.pinName || "ph:paw-print-fill";
              return (
                <span
                  key={animalName}
                  className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-accent text-accent-foreground text-[11px] font-semibold uppercase tracking-wide"
                >
                  <AnimalIcon pinName={pin} className="size-3.5" />
                  {animalName}
                </span>
              );
            })}
          </div>
        )}
      </div>

      {/* Location */}
      {data.address && (
        <div
          className="flex items-center gap-1.5 text-xs text-muted-foreground min-w-0 shrink-0"
          title={data.address}
        >
          <MapPin className="size-3.5 shrink-0 text-primary" />
          <span className="truncate">{data.address}</span>
        </div>
      )}

      {/* Scrollable Content Area (Description + Photo Grid) */}
      <div className="flex-1 overflow-y-auto custom-scrollbar flex flex-col gap-3 pr-0.5 min-h-0">
        {data.description && (
          <p className="text-sm font-medium text-muted-foreground leading-relaxed shrink-0">
            {data.description}
          </p>
        )}

        {images.length > 0 && (
          <div className="grid grid-cols-2 gap-3 pt-0.5">
            {displayedImages.map((imgUrl, idx) => {
              const isSecondAndCollapsed =
                !showAllPhotos && hasMoreThanTwo && idx === 1;
              const remainingCount = images.length - 2;
              const isSelected = activePhotoIndex === idx;

              return (
                <div
                  key={idx}
                  onClick={() => {
                    if (isSecondAndCollapsed) {
                      setShowAllPhotos(true);
                    } else {
                      onPhotoClick?.(imgUrl, idx);
                    }
                  }}
                  className={`aspect-[3/4] rounded-2xl overflow-hidden bg-muted relative group cursor-pointer shadow-sm transition-all ${
                    isSelected ? "ring-2 ring-accent ring-offset-2" : ""
                  }`}
                >
                  <img
                    src={imgUrl}
                    alt={`${data.title} - ${idx + 1}`}
                    className="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />

                  {isSecondAndCollapsed && (
                    <div className="absolute inset-0 bg-black/55 backdrop-blur-[1px] flex flex-col items-center justify-center text-white font-semibold transition-opacity group-hover:bg-black/65">
                      <span className="text-base font-bold">
                        +{remainingCount}
                      </span>
                      <span className="text-xs">More</span>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </div>

      {/* View all / Show less button */}
      {hasMoreThanTwo && (
        <button
          type="button"
          onClick={() => setShowAllPhotos((prev) => !prev)}
          className="w-full py-2.5 rounded-full bg-muted hover:bg-muted/80 text-foreground text-xs font-semibold flex items-center justify-center gap-1 transition-colors shrink-0 cursor-pointer"
        >
          <span>
            {showAllPhotos ? "Show less" : `View all ${images.length} photos`}
          </span>
          <ChevronDown
            className={`size-4 transition-transform duration-200 ${
              showAllPhotos ? "rotate-180" : ""
            }`}
          />
        </button>
      )}
    </div>
  );
}
</file>

<file path="components/map/SpotPhotoViewerModal.tsx">
"use client";

import { useState, useEffect } from "react";
import { createPortal } from "react-dom";
import { X, ChevronLeft, ChevronRight } from "lucide-react";

interface SpotPhotoViewerModalProps {
  isOpen: boolean;
  onClose: () => void;
  images: string[];
  initialIndex?: number;
}

export default function SpotPhotoViewerModal({
  isOpen,
  onClose,
  images,
  initialIndex = 0,
}: SpotPhotoViewerModalProps) {
  const [currentIndex, setCurrentIndex] = useState(initialIndex);
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
  }, []);

  useEffect(() => {
    setCurrentIndex(initialIndex);
  }, [initialIndex, isOpen]);

  useEffect(() => {
    if (!isOpen) return;
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") onClose();
      if (e.key === "ArrowLeft") {
        setCurrentIndex((prev) => (prev === 0 ? images.length - 1 : prev - 1));
      }
      if (e.key === "ArrowRight") {
        setCurrentIndex((prev) => (prev === images.length - 1 ? 0 : prev + 1));
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [isOpen, images.length, onClose]);

  if (!isOpen || !mounted || images.length === 0) return null;

  const modalContent = (
    <div
      className="fixed inset-0 z-[9999] bg-black/90 backdrop-blur-sm flex items-center justify-center p-4"
      onClick={onClose}
    >
      {/* ปุ่มปิดมุมขวาบน */}
      <button
        type="button"
        onClick={onClose}
        className="absolute top-4 right-4 z-10 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer"
        aria-label="Close photo viewer"
      >
        <X className="size-6" />
      </button>

      {/* ตัวนับจำนวนรูป */}
      {images.length > 1 && (
        <div className="absolute top-5 left-1/2 -translate-x-1/2 z-10 px-3 py-1 rounded-full bg-black/60 text-white text-xs font-medium">
          {currentIndex + 1} / {images.length}
        </div>
      )}

      {/* ปุ่มเลื่อนซ้าย */}
      {images.length > 1 && (
        <button
          type="button"
          onClick={(e) => {
            e.stopPropagation();
            setCurrentIndex((prev) =>
              prev === 0 ? images.length - 1 : prev - 1
            );
          }}
          className="absolute left-4 z-10 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer"
          aria-label="Previous photo"
        >
          <ChevronLeft className="size-6" />
        </button>
      )}

      {/* รูปภาพหลัก */}
      <img
        src={images[currentIndex]}
        alt={`Spot photo ${currentIndex + 1}`}
        onClick={(e) => e.stopPropagation()}
        className="max-h-[88dvh] max-w-[92vw] object-contain rounded-xl shadow-2xl select-none"
      />

      {/* ปุ่มเลื่อนขวา */}
      {images.length > 1 && (
        <button
          type="button"
          onClick={(e) => {
            e.stopPropagation();
            setCurrentIndex((prev) =>
              prev === images.length - 1 ? 0 : prev + 1
            );
          }}
          className="absolute right-4 z-10 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer"
          aria-label="Next photo"
        >
          <ChevronRight className="size-6" />
        </button>
      )}
    </div>
  );

  return createPortal(modalContent, document.body);
}
</file>

